[
  { "//": "How what the simulation reports is played back (12 §7): a `show` for each event of the kernel and the world, saying how it changes the picture, what it animates and what line it writes, worded for the reader. Several shows may match one event and all apply. An event with no show is applied silently: what it is about is looked at again. A show with an empty `change` says the event changes nothing the party sees. Log lines are always written; the preference `effects` says whose animations, shake and flash play.",
    "type": "preference", "id": "effects", "kind": "choice", "default": "all",
    "options": ["all", "major", "none"],
    "name": "Effects",
    "doc": "Which events are played with their animations, shake and flash: all of them, only those that matter most, or none. Moves are then drawn as jumps. The log is the same whichever is chosen." },

  { "//": "Animations: a glyph over a cell for a moment.",
    "type": "anim", "id": "burst", "time": "300 ms",
    "frames": [ { "ch": "*", "fg": "white", "bold": true },
                { "at": 0.4, "ch": "%", "fg": "amber", "bold": false },
                { "at": 0.75, "ch": ",", "fg": "ash" } ] },
  { "type": "anim", "id": "dust", "time": "450 ms",
    "frames": [ { "ch": ":", "fg": "bone" }, { "at": 0.5, "ch": ".", "fg": "ash" } ] },
  { "type": "anim", "id": "thud", "time": "200 ms",
    "frames": [ { "ch": "!", "fg": "amber", "bold": true } ] },
  { "type": "anim", "id": "chip", "time": "120 ms",
    "frames": [ { "ch": "'", "fg": "bone" } ] },

  { "//": "Things moving, appearing and going. A step writes no line: the glide is the whole of it.",
    "type": "show", "id": "step", "on": "entity_relocated",
    "change": [ { "sprite": { "of": "self", "to": "here" } } ],
    "time": "120 ms", "importance": "minor", "sound": "step" },
  { "//": "A new thing is nowhere until it is put somewhere: `entity_relocated` brings it into the picture.",
    "type": "show", "id": "created", "on": "entity_created", "change": [] },
  { "type": "show", "id": "removed", "on": "entity_removed",
    "change": [ { "gone": "self" } ], "importance": "minor" },
  { "//": "The world's own notices that an occupant was moved, lost its footing or was struck are followed by the kernel's events about the entity, which are shown instead.",
    "type": "show", "id": "displaced", "on": "occupant_displaced", "change": [],
    "log": "{the(target)} {verb(target, 'stagger')} aside.", "importance": "minor" },
  { "type": "show", "id": "occupant_unsupported", "on": "occupant_unsupported", "change": [] },
  { "type": "show", "id": "occupant_exposed", "on": "occupant_exposed", "change": [] },
  { "type": "show", "id": "entombed", "on": "occupant_entombed", "change": [],
    "log": "Rubble closes in around {the(target)}.", "importance": "major",
    "heard": { "log": "Someone cries out under falling rubble.", "marker": "!" } },
  { "type": "show", "id": "unsupported", "on": "entity_unsupported", "change": [],
    "log": "{the(self)} {verb(self, 'lose')} {their(self)} footing." },
  { "type": "show", "id": "exposed", "on": "entity_exposed", "change": [],
    "anim": "thud", "at": "here", "shake": 0.2,
    "log": "Debris strikes {the(self)}.", "sound": "debris_hit",
    "heard": { "log": "Something heavy lands with a thud.", "marker": "!" } },

  { "//": "Cells. A cell that changed is looked at again; a mark left or cleared is too. Small changes write no line.",
    "type": "show", "id": "element_changed", "on": "element_changed",
    "change": [ { "cell": "here" } ], "importance": "minor" },
  { "type": "show", "id": "element_damaged", "on": "element_damaged",
    "change": [ { "cell": "here" } ], "anim": "chip", "importance": "minor" },
  { "type": "show", "id": "decal_added", "on": "decal_added",
    "change": [ { "cell": "here" } ], "importance": "minor" },
  { "type": "show", "id": "decals_removed", "on": "decals_removed",
    "change": [ { "cell": "here" } ], "importance": "minor" },

  { "//": "Destruction, by what broke and how. Each looks at the cell again and plays an animation there; the lines name who did it as the reader knows them.",
    "type": "show", "id": "wall_broken", "on": "element_destroyed",
    "filter": { "layer": "block", "how": "damage" }, "if": "not is_null(actor)",
    "change": [ { "cell": "here" } ], "anim": "burst", "shake": 0.15, "time": "250 ms",
    "log": "{the(actor)} {verb(actor, 'break')} the wall.", "sound": "break",
    "heard": { "log": "Something breaks nearby.", "marker": "!" } },
  { "type": "show", "id": "wall_breaks", "on": "element_destroyed",
    "filter": { "layer": "block", "how": "damage" }, "if": "is_null(actor)",
    "change": [ { "cell": "here" } ], "anim": "burst", "shake": 0.15, "time": "250 ms",
    "log": "A wall breaks apart.", "sound": "break",
    "heard": { "log": "Something breaks nearby.", "marker": "!" } },
  { "type": "show", "id": "floor_broken", "on": "element_destroyed",
    "filter": { "layer": "floor", "how": "damage" }, "if": "not is_null(actor)",
    "change": [ { "cell": "here" } ], "anim": "burst", "shake": 0.1,
    "log": "{the(actor)} {verb(actor, 'break')} through the floor.", "sound": "break",
    "heard": { "log": "Boards splinter somewhere close.", "marker": "!" } },
  { "type": "show", "id": "floor_breaks", "on": "element_destroyed",
    "filter": { "layer": "floor", "how": "damage" }, "if": "is_null(actor)",
    "change": [ { "cell": "here" } ], "anim": "burst", "shake": 0.1,
    "log": "The floor gives way.", "sound": "break",
    "heard": { "log": "Boards splinter somewhere close.", "marker": "!" } },
  { "type": "show", "id": "fixture_broken", "on": "element_destroyed",
    "filter": { "layer": "fixture", "how": "damage" }, "if": "not is_null(actor)",
    "change": [ { "cell": "here" } ], "anim": "burst",
    "log": "{the(actor)} {verb(actor, 'smash')} something to pieces.", "sound": "break",
    "heard": { "log": "Something smashes nearby.", "marker": "!" } },
  { "type": "show", "id": "fixture_breaks", "on": "element_destroyed",
    "filter": { "layer": "fixture", "how": "damage" }, "if": "is_null(actor)",
    "change": [ { "cell": "here" } ], "anim": "burst",
    "log": "Something breaks to pieces.", "sound": "break",
    "heard": { "log": "Something smashes nearby.", "marker": "!" } },
  { "type": "show", "id": "crushed", "on": "element_destroyed",
    "filter": { "how": "crushed" },
    "change": [ { "cell": "here" } ], "anim": "dust", "shake": 0.3, "time": "400 ms",
    "log": "Something gives way under the weight above it.", "importance": "major", "sound": "crush",
    "heard": { "log": "Timbers groan and snap somewhere near.", "marker": "!" } },
  { "type": "show", "id": "fell", "on": "element_destroyed",
    "filter": { "how": "fell" },
    "change": [ { "cell": "here" } ], "anim": "dust",
    "log": "Debris crashes down.", "sound": "debris",
    "heard": { "log": "Debris crashes down somewhere.", "marker": "!" } },

  { "//": "Collapse: the cells change through the destruction that comes with it.",
    "type": "show", "id": "collapse_started", "on": "collapse_started", "change": [],
    "shake": 0.5, "time": "700 ms", "min_time": "300 ms", "flash": "ash",
    "log": "With a roar, the structure starts to come down.", "importance": "major", "sound": "collapse",
    "heard": { "log": "A deep rumble comes from somewhere close.", "marker": "!" } },
  { "type": "show", "id": "collapse_settled", "on": "collapse_settled", "change": [],
    "log": "The dust settles.", "importance": "minor" },

  { "//": "Fields: the strongest field of a cell is looked at again when one appears or goes. Contact and doses are for the simulation to report in its own words.",
    "type": "show", "id": "field_appeared", "on": "field_appeared",
    "change": [ { "field": "here" } ], "importance": "minor" },
  { "type": "show", "id": "field_vanished", "on": "field_vanished",
    "change": [ { "field": "here" } ], "importance": "minor" },
  { "type": "show", "id": "field_contact", "on": "field_contact", "change": [] },
  { "type": "show", "id": "occupant_dosed", "on": "occupant_dosed", "change": [] },
  { "type": "show", "id": "field_budget_exceeded", "on": "field_budget_exceeded", "change": [] },

  { "//": "Bodies in flight are drawn where they start, strike and land; what a blow does to an element or to someone is told by the events that follow it.",
    "type": "show", "id": "thrown", "on": "body_launched", "filter": { "owner": "entity" },
    "change": [], "anim": "dust", "at": "here",
    "log": "{the(target)} {verb(target, 'go')} flying.", "importance": "major", "sound": "whoosh",
    "heard": { "log": "Something heavy is thrown about nearby.", "marker": "!" } },
  { "type": "show", "id": "debris_flies", "on": "body_launched", "filter": { "owner": "debris" },
    "change": [], "anim": "chip", "at": "here", "importance": "minor" },
  { "type": "show", "id": "projectile_flies", "on": "body_launched", "filter": { "owner": "projectile" },
    "change": [], "importance": "minor" },
  { "type": "show", "id": "body_impact", "on": "body_impact",
    "change": [ { "cell": "here" } ], "anim": "thud", "at": "here", "shake": 0.1,
    "importance": "minor", "sound": "impact" },
  { "type": "show", "id": "body_hit_occupant", "on": "body_hit_occupant",
    "change": [], "anim": "thud", "at": "here", "shake": 0.2,
    "log": "Something strikes {the(target)}.", "sound": "impact",
    "heard": { "log": "A heavy thud comes from somewhere close.", "marker": "!" } },
  { "type": "show", "id": "landed", "on": "body_landed", "filter": { "owner": "entity" },
    "change": [ { "sprite": { "of": "target", "to": "here" } } ], "anim": "dust", "at": "here",
    "log": "{the(target)} {verb(target, 'land')} hard.", "sound": "land" },
  { "type": "show", "id": "debris_lands", "on": "body_landed", "filter": { "owner": "debris" },
    "change": [ { "cell": "here" } ], "anim": "dust", "at": "here",
    "log": "Debris clatters down.", "importance": "minor", "sound": "debris" },
  { "type": "show", "id": "projectile_lands", "on": "body_landed", "filter": { "owner": "projectile" },
    "change": [ { "cell": "here" } ], "importance": "minor" },
  { "type": "show", "id": "body_left_loaded", "on": "body_left_loaded",
    "change": [ { "sprite": "target" } ] },

  { "//": "Blasts: the front's destruction is told by the elements' own events.",
    "type": "show", "id": "blast", "on": "release_started", "change": [],
    "anim": "burst", "at": "here", "shake": 0.6, "flash": "amber", "time": "600 ms", "min_time": "250 ms",
    "log": "A blast tears through the air.", "importance": "major", "sound": "blast",
    "heard": { "log": "A blast booms somewhere close.", "marker": "!" } },
  { "type": "show", "id": "blast_spent", "on": "energy_released", "change": [] },

  { "//": "What changes nothing the party sees: no line, no picture.",
    "type": "show", "id": "cell_var_changed", "on": "cell_var_changed", "change": [] },
  { "type": "show", "id": "area_entered", "on": "area_entered", "change": [] },
  { "type": "show", "id": "area_exited", "on": "area_exited", "change": [] },
  { "type": "show", "id": "area_breached", "on": "area_breached", "change": [] },
  { "type": "show", "id": "area_closed", "on": "area_closed", "change": [] },
  { "type": "show", "id": "tract_loaded", "on": "tract_loaded", "change": [] },
  { "type": "show", "id": "tract_unloading", "on": "tract_unloading", "change": [] },
  { "type": "show", "id": "ticket_refused", "on": "ticket_refused", "change": [] },
  { "type": "show", "id": "spawn_requested", "on": "spawn_requested", "change": [] },
  { "type": "show", "id": "control_changed", "on": "control_changed", "change": [] },
  { "type": "show", "id": "clock_rate_changed", "on": "clock_rate_changed", "change": [] },
  { "type": "show", "id": "decision_requested", "on": "decision_requested", "change": [] },
  { "type": "show", "id": "var_changed", "on": "var_changed", "change": [] },
  { "type": "show", "id": "fault", "on": "fault", "change": [] },
  { "type": "show", "id": "event_cancelled", "on": "event_cancelled", "change": [] }
]
