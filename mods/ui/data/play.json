[
  { "//": "The play screen: the map, the log and a status column. A profile names it for the roles `play` and `decision.free`. Its keys are in the keymap's `play` context and what they do is in controls.json; nothing here names a key. Other mods add to it through its two slots: `ui:play.bars` for a character's reserves and `ui:play.side` for anything else in the column.",
    "type": "screen", "id": "play",
    "title": "Play",
    "context": "play",
    "min_size": [80, 24],
    "layout": { "cols": [
      { "fill": 1, "rows": [
        { "fill": 1, "map_view": { "id": "map" } },
        { "height": 7, "frame": "Log", "log": { "id": "log" } } ] },
      { "id": "status", "width": 26, "frame": true, "rows": [
        { "id": "who", "if": "not is_null(view)", "text": "<title>{cap(name(view))}</>" },
        { "if": "is_null(view)", "text": "<dim>Nobody is yours to play.</>" },
        { "if": "len(party) > 1", "text": "<dim>One of {len(party)}.</>" },
        { "slot": "play.bars" },
        { "slot": "play.side" },
        { "spacer": {} },
        { "tooltip": { "value": "x looks around." } } ] } ] } },

  { "//": "Look mode: a free cursor over the map, with what the party knows of the place under it. The `look` control opens it. The scene keeps the variables `cursor_sight`, `cursor_distance` and `cursor_target` up to date for any screen that declares them.",
    "type": "screen", "id": "look",
    "title": "Look",
    "context": "targeting",
    "min_size": [40, 10],
    "vars": { "cursor_sight": "unknown", "cursor_distance": 0.5, "cursor_target": "" },
    "layout": { "rows": [
      { "fill": 1, "map_view": { "id": "map" } },
      { "id": "status", "height": 1,
        "text": { "value": "<title>Look</>  {if screen.cursor_target != '' then cap(screen.cursor_target) else 'Nobody there'}. {if screen.cursor_sight == 'seen' then 'In sight' else if screen.cursor_sight == 'remembered' then 'Remembered' else 'Not known'}, {screen.cursor_distance:.1} m away.",
                  "wrap": false } },
      { "height": 1,
        "text": { "value": "<dim>Direction keys move, Tab goes to the next thing, << and > change storey, Esc leaves.</>", "wrap": false } } ] },
    "keys": {
      "north": [ { "camera": { "move": [0, -1] } } ],
      "north_east": [ { "camera": { "move": [1, -1] } } ],
      "east": [ { "camera": { "move": [1, 0] } } ],
      "south_east": [ { "camera": { "move": [1, 1] } } ],
      "south": [ { "camera": { "move": [0, 1] } } ],
      "south_west": [ { "camera": { "move": [-1, 1] } } ],
      "west": [ { "camera": { "move": [-1, 0] } } ],
      "north_west": [ { "camera": { "move": [-1, -1] } } ],
      "up": [ { "camera": { "storey": 1 } } ],
      "down": [ { "camera": { "storey": -1 } } ],
      "next_target": [ { "camera": { "cycle": 1 } } ],
      "prev_target": [ { "camera": { "cycle": -1 } } ],
      "zoom_in": [ { "camera": { "zoom": -1 } } ],
      "zoom_out": [ { "camera": { "zoom": 1 } } ],
      "back": [ { "camera": "release" }, { "close": {} } ] } },

  { "//": "Placeholders for the bundled screens that are not built yet: each is an empty titled screen that Esc leaves, so that the controls that open them can be bound and tried.",
    "type": "screen", "id": "inventory", "title": "Inventory",
    "layout": { "frame": "Inventory", "rows": [ { "spacer": {} } ] },
    "keys": { "back": [ { "close": {} } ] } },
  { "type": "screen", "id": "condition", "title": "Condition",
    "layout": { "frame": "Condition", "rows": [ { "spacer": {} } ] },
    "keys": { "back": [ { "close": {} } ] } },
  { "type": "screen", "id": "abilities", "title": "Abilities",
    "layout": { "frame": "Abilities", "rows": [ { "spacer": {} } ] },
    "keys": { "back": [ { "close": {} } ] } },
  { "type": "screen", "id": "map", "title": "Map",
    "layout": { "frame": "Map", "rows": [ { "spacer": {} } ] },
    "keys": { "back": [ { "close": {} } ] } },
  { "type": "screen", "id": "journal", "title": "Journal",
    "layout": { "frame": "Journal", "rows": [ { "spacer": {} } ] },
    "keys": { "back": [ { "close": {} } ] } },
  { "type": "screen", "id": "options", "title": "Options",
    "layout": { "frame": "Options", "rows": [ { "spacer": {} } ] },
    "keys": { "back": [ { "close": {} } ] } },
  { "//": "What the second mouse button opens on the map. A profile names it for the role `context_menu`. `place` is what was clicked.",
    "type": "screen", "id": "context_menu", "title": "Here",
    "params": { "place": "any" },
    "popup": { "width": 30, "height": 6, "place": "centre" },
    "layout": { "frame": "Here", "rows": [ { "spacer": {} } ] },
    "keys": { "back": [ { "close": {} } ] } }
]
