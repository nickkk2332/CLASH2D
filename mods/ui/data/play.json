[
  { "//": "The play screen: the map, the log and a status column. A profile names it for the roles `play` and `decision.free`. Its keys are in the keymap's `play` context and what they do is in controls.json; nothing here names a key. Other mods add to it through its two slots: `ui:play.bars` for a character's reserves and `ui:play.side` for anything else in the column.",
    "type": "screen", "id": "play",
    "title": "Play",
    "context": "play",
    "min_size": [80, 24],
    "layout": { "cols": [
      { "fill": 1, "rows": [
        { "fill": 1, "map_view": { "id": "map" } },
        { "height": 7, "frame": "Log", "log": { "id": "log" } } ] },
      { "id": "status", "width": 26, "frame": true, "rows": [
        { "id": "who", "if": "not is_null(view)", "text": "<title>{cap(name(view))}</>" },
        { "if": "is_null(view)", "text": "<dim>Nobody is yours to play.</>" },
        { "if": "len(party) > 1", "text": "<dim>One of {len(party)}.</>" },
        { "id": "target", "if": "not is_null(app.target)", "text": "<dim>Target</> {cap(the(app.target))}" },
        { "slot": "play.bars" },
        { "id": "held", "if": "len(view.held('grasp') ?? []) > 0",
          "text": "<dim>Holding</> {list(view.held('grasp'))}" },
        { "slot": "play.side" },
        { "spacer": {} },
        { "id": "help", "rows": [
          { "text": { "value": "<dim>Tab target f hit s shoot</>", "wrap": false } },
          { "text": { "value": "<dim>x look  i things  c body</>", "wrap": false } },
          { "text": { "value": "<dim>? keys  Esc menu</>", "wrap": false } } ] } ] } ] } },

  { "//": "Look mode: a free cursor over the map, with what the party knows of the place under it, and a side panel with what the view model holds of that cell: the ground, as last seen, and every thing perceived there, named in the reader's terms. The `look` control opens it. The scene keeps the variables `cursor_sight`, `cursor_distance`, `cursor_target`, `cursor_things` and `cursor_ground` up to date for any screen that declares them; nothing here reads the world. Mods add to the panel through the slot `ui:look.side`.",
    "type": "screen", "id": "look",
    "title": "Look",
    "context": "targeting",
    "min_size": [40, 10],
    "vars": { "cursor_sight": "unknown", "cursor_distance": 0.5, "cursor_target": "", "cursor_things": "", "cursor_ground": "" },
    "layout": { "rows": [
      { "fill": 1, "cols": [
        { "fill": 1, "map_view": { "id": "map" } },
        { "id": "panel", "width": 24, "frame": "Here", "rows": [
          { "text": "{if screen.cursor_sight == 'seen' then 'In sight' else if screen.cursor_sight == 'remembered' then 'Remembered' else 'Not known'}, {screen.cursor_distance:.1} m away." },
          { "height": 1, "spacer": {} },
          { "text": "<header>Ground</>" },
          { "text": "{if screen.cursor_ground != '' then cap(screen.cursor_ground) + '.' else 'Nothing known.'}" },
          { "height": 1, "spacer": {} },
          { "text": "<header>Things</>" },
          { "text": "{if screen.cursor_things != '' then cap(screen.cursor_things) + '.' else 'Nothing seen.'}" },
          { "slot": "look.side" },
          { "spacer": {} } ] } ] },
      { "id": "status", "height": 1,
        "text": { "value": "<title>Look</>  {if screen.cursor_target != '' then cap(screen.cursor_target) else 'Nobody there'}. {if screen.cursor_sight == 'seen' then 'In sight' else if screen.cursor_sight == 'remembered' then 'Remembered' else 'Not known'}, {screen.cursor_distance:.1} m away.",
                  "wrap": false } },
      { "height": 1,
        "text": { "value": "<dim>Direction keys move, Tab goes to the next thing, << and > change storey, Esc leaves.</>", "wrap": false } } ] },
    "keys": {
      "north": [ { "camera": { "move": [0, -1] } } ],
      "north_east": [ { "camera": { "move": [1, -1] } } ],
      "east": [ { "camera": { "move": [1, 0] } } ],
      "south_east": [ { "camera": { "move": [1, 1] } } ],
      "south": [ { "camera": { "move": [0, 1] } } ],
      "south_west": [ { "camera": { "move": [-1, 1] } } ],
      "west": [ { "camera": { "move": [-1, 0] } } ],
      "north_west": [ { "camera": { "move": [-1, -1] } } ],
      "up": [ { "camera": { "storey": 1 } } ],
      "down": [ { "camera": { "storey": -1 } } ],
      "next_target": [ { "camera": { "cycle": 1 } } ],
      "prev_target": [ { "camera": { "cycle": -1 } } ],
      "zoom_in": [ { "camera": { "zoom": -1 } } ],
      "zoom_out": [ { "camera": { "zoom": 1 } } ],
      "back": [ { "camera": "release" }, { "close": {} } ] } },

  { "//": "The map (12 §10.7): the place as the character knows it, drawn zoomed out from the view model, which holds only what the party has seen and remembers, never the world; the character where it is; the journal's markers pinned where the character last perceived their targets (the theme mark `marker`); and beside it the sites the character knows by name (`view.known_sites`: those whose heart it remembers) and its objectives with which way and how far each marker is. The direction keys move the view a stretch at a time and << and > change storey; Esc goes back. The `map` control opens it. The region map and the chart of 12 §6.2 are not built: this is the view of the place the character is in.",
    "type": "screen", "id": "map", "title": "Map",
    "context": "targeting",
    "min_size": [60, 16],
    "layout": { "cols": [
      { "fill": 1, "frame": "Map", "rows": [
        { "fill": 1, "map_view": { "id": "map", "zoom": 3 } },
        { "height": 1, "text": { "value": "<dim>Direction keys move, << > storey, Esc goes back.</>", "wrap": false } } ] },
      { "id": "known", "width": 28, "frame": "Known", "rows": [
        { "text": "<header>Places</>" },
        { "fill": 1,
          "list": { "id": "places", "rows": "view.known_sites ?? []",
                    "item": "{it.name}  <dim>{it.where}</>",
                    "empty": "Nowhere known by name yet." } },
        { "text": "<header>Markers</>" },
        { "fill": 1,
          "list": { "id": "markers", "rows": "view.objectives ?? []",
                    "item": "<dim>{if it.where == '' then '-' else it.where}</> {it.text}",
                    "empty": "Nothing to find." } } ] } ] },
    "keys": {
      "north": [ { "camera": { "move": [0, -6] } } ],
      "north_east": [ { "camera": { "move": [6, -6] } } ],
      "east": [ { "camera": { "move": [6, 0] } } ],
      "south_east": [ { "camera": { "move": [6, 6] } } ],
      "south": [ { "camera": { "move": [0, 6] } } ],
      "south_west": [ { "camera": { "move": [-6, 6] } } ],
      "west": [ { "camera": { "move": [-6, 0] } } ],
      "north_west": [ { "camera": { "move": [-6, -6] } } ],
      "up": [ { "camera": { "storey": 1 } } ],
      "down": [ { "camera": { "storey": -1 } } ],
      "back": [ { "camera": "release" }, { "close": {} } ] } },

  { "//": "What the second mouse button opens on the map (12 §9.4). A profile names it for the role `context_menu`. `place` is what was clicked: `cell`, `entity` (the thing perceived there, or null), `x`, `y`, `z`. It offers what can be done with it: a creature can be attacked, shot at, talked to or made the target; any place can be gone to; what is near can be used; and look mode opens. Each is the control or action the keys reach, so nothing here is new.",
    "type": "screen", "id": "context_menu", "title": "Here",
    "params": { "place": "any" },
    "popup": { "width": 30, "place": "centre" },
    "layout": { "frame": "{if is_null($place.entity) then 'Here' else cap(the($place.entity))}", "rows": [
      { "if": "not is_null($place.entity)",
        "button": { "id": "attack", "label": "Attack",
                    "on_activate": [ { "act": { "action": { "first": "view.actions_with('strike', $place.entity)" },
                                                "params": "needed", "with": { "target": "$place.entity" } } },
                                     { "close": {} } ] } },
      { "if": "not is_null($place.entity)",
        "button": { "id": "shoot", "label": "Shoot",
                    "on_activate": [ { "act": { "action": { "first": "view.actions_with('shot', $place.entity)" },
                                                "params": "needed", "with": { "target": "$place.entity" } } },
                                     { "close": {} } ] } },
      { "if": "not is_null($place.entity)",
        "button": { "id": "talk", "label": "Talk",
                    "on_activate": [ { "app": { "talk": { "to": "$place.entity" } } },
                                     { "replace": { "screen": "talk", "with": { "who": "$place.entity" } } } ] } },
      { "button": { "id": "go", "label": "Go there",
                    "on_activate": [ { "act": { "action": "go_to", "params": { "to": "$place.cell" } } }, { "close": {} } ] } },
      { "button": { "id": "use", "label": "Use what is near",
                    "on_activate": [ { "replace": "interact" } ] } },
      { "button": { "id": "look", "label": "Look around",
                    "on_activate": [ { "replace": "look" }, { "camera": { "move": [0, 0] } } ] } },
      { "text": "<dim>Enter does it, Esc goes back.</>" } ] },
    "keys": { "back": [ { "close": {} } ] } }
]
