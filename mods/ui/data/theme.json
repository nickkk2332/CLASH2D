  { "//": "What each key means, by context. A screen names its context; a key its context does not name is looked up in `menu`. `menu` holds the names the toolkit navigates by. `play` is the play screen's: its names are controls (controls.json). `targeting` is that of look mode and of the pickers that move a cursor or take a direction: there the direction keys keep their names and the screens say what they do.",
    "type": "keymap", "id": "default",
    "menu": {
      "up": "prev", "down": "next", "left": "left", "right": "right",
      "enter": "accept", "space": "toggle",
      "escape": "back", "q": "back",
      "tab": "focus_next", "shift+tab": "focus_prev",
      "page_up": "page_prev", "page_down": "page_next", "home": "first", "end": "last",
      "backspace": "erase", "delete": "delete",
      "ctrl+d": "done",
      "f2": "more"
    },
    "play": {
      "h": "west", "j": "south", "k": "north", "l": "east",
      "y": "north_west", "u": "north_east", "b": "south_west", "n": "south_east",
      "left": "west", "down": "south", "up": "north", "right": "east",
      "<": "up", ">": "down",
      ".": "wait", "x": "look", "e": "interact",
      "i": "inventory", "c": "condition", "a": "abilities", "m": "map", "shift+j": "journal",
      "shift+m": "make", "shift+k": "know_how",
      "o": "options", "?": "help", "f1": "help",
      "escape": "pause", "f12": "omniscient"
    },
    "targeting": {
      "h": "west", "j": "south", "k": "north", "l": "east",
      "y": "north_west", "u": "north_east", "b": "south_west", "n": "south_east",
      "left": "west", "down": "south", "up": "north", "right": "east",
      "<": "up", ">": "down",
      "tab": "next_target", "shift+tab": "prev_target",
      "+": "zoom_in", "-": "zoom_out"
    }
  }
]
