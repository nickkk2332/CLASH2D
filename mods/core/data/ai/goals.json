[
  { "//": "Goals the bundled minds share (09 §3.2). Each is scored from what the character believes and from its mind's weights, and pursued by its methods' steps: actions, waits and words a player could choose for it. Nothing here names the player.",
    "type": "goal", "id": "go_about",
    "doc": "Going about one's day near home: standing a while, then most times a walk to somewhere close by. Always wanted a little, so it is what a character does when nothing else matters. A character just come into the world stands a few seconds before it goes anywhere.",
    "score": "0.2",
    "noise": 0.05,
    "methods": [
      { "steps": [
          { "wait": { "time": "rand(4, 10)" } },
          { "if": "chance(0.7)", "go": { "to": "offset(self.home, rand_int(-8, 8), rand_int(-8, 8))" } } ] },
      { "steps": [ { "wait": { "time": "rand(4, 10)" } } ] }
    ] },

  { "type": "goal", "id": "patrol",
    "doc": "Walking a beat: to a point eight metres east of home and back, pausing at each end.",
    "score": "0.3 * self.weight('duty')",
    "methods": [
      { "steps": [
          { "go": { "to": "offset(self.home, 8, 0)" } },
          { "look": { "time": "2 s" } },
          { "go": { "to": "self.home" } },
          { "look": { "time": "2 s" } } ] }
    ] },

  { "type": "goal", "id": "investigate_noise",
    "doc": "Going to look where something was heard and not seen, then letting it go: the memory is settled, and the character goes back to what it was doing.",
    "about": { "memory": {
      "events": ["element_destroyed", "body_impact", "release_started", "collapse_started", "said"],
      "where": "it.how == 'core:sound' and it.actor == null and it.age < 60 and it.loc != null",
      "best": "it.salience" } },
    "score": "self.weight('curiosity') * $about.salience * 2",
    "commit": 0.25,
    "interrupts": true,
    "retry_after": "20 s",
    "methods": [
      { "steps": [
          { "go": { "to": "$about.loc", "within": 2 } },
          { "look": { "at": "$about.loc", "time": "3 s" } },
          { "settle": true } ] },
      { "steps": [
          { "look": { "at": "$about.loc", "time": "2 s" } },
          { "settle": true } ] }
    ] },

  { "type": "goal", "id": "flee_danger",
    "doc": "Getting away from something dangerous that happened close by, seen or heard: a fight, a blast, a collapse. Calls out first.",
    "about": { "memory": {
      "events": ["hit_landed", "wound_inflicted", "release_started", "collapse_started", "entity_died"],
      "where": "it.age < 20 and it.loc != null and it.actor != self and (dist(self, it.loc) ?? 99) < 15",
      "best": "it.salience" } },
    "score": "self.weight('caution') * $about.salience * 2.5",
    "commit": 0.3,
    "interrupts": true,
    "retry_after": "5 s",
    "methods": [
      { "steps": [
          { "if": "now() - self.var.called_out_at > 30", "say": { "text": "Help!", "volume": 2, "kind": "help" } },
          { "if": "now() - self.var.called_out_at > 30", "set": { "var": "core:called_out_at", "value": "now()" } },
          { "keep_from": { "from": "$about.loc", "distance": 12 } },
          { "wait": { "time": "3 s" } },
          { "settle": true } ] },
      { "steps": [
          { "wait": { "time": "2 s" } },
          { "settle": true } ] }
    ] },

  { "type": "goal", "id": "flee_feared",
    "doc": "Keeping away from someone feared, while they are believed to be close, calling out for help now and then.",
    "about": { "track": {
      "where": "self.fears(it) and (self.confidence(it) ?? 0) > 0.3 and (dist(self, self.believed_loc(it)) ?? 99) < 12",
      "best": "0 - (dist(self, self.believed_loc(it)) ?? 99)" } },
    "score": "self.weight('caution') * 3 * (self.confidence($about) ?? 0)",
    "commit": 0.3,
    "interrupts": true,
    "methods": [
      { "steps": [
          { "if": "now() - self.var.called_out_at > 30", "say": { "text": "Help!", "volume": 2, "kind": "help" } },
          { "if": "now() - self.var.called_out_at > 30", "set": { "var": "core:called_out_at", "value": "now()" } },
          { "keep_from": { "from": "$about", "distance": 15 } },
          { "wait": { "time": "2 s" } } ] },
      { "steps": [ { "wait": { "time": "2 s" } } ] }
    ] },

  { "type": "variable", "id": "called_out_at", "scope": "entity", "value": "real", "default": -1000,
    "doc": "When a character last called out, in seconds of universal time: a character calls once in a while, not at every step." },

  { "type": "goal", "id": "confront",
    "doc": "Going for someone held hostile who is in sight: up to them, then at them with the first blow that can be struck (an action tagged `strike`: `punch`, `kick`, …), or, with none that can, standing over them.",
    "about": { "track": {
      "where": "self.hostile(it) and (self.last_seen(it) ?? 99) < 3",
      "best": "0 - (dist(self, self.believed_loc(it)) ?? 99)" } },
    "score": "self.weight('duty') * 3",
    "commit": 0.3,
    "interrupts": true,
    "methods": [
      { "steps": [
          { "if": "now() - self.var.called_out_at > 30", "say": { "text": "Stop right there!", "volume": 2 } },
          { "if": "now() - self.var.called_out_at > 30", "set": { "var": "core:called_out_at", "value": "now()" } },
          { "go": { "to": "$about", "within": 1.5 } },
          { "choose": { "purpose": "strike", "target": "$about" } } ] },
      { "steps": [
          { "go": { "to": "$about", "within": 1.5 } },
          { "look": { "at": "$about", "time": "1 s" } } ] }
    ] },

  { "type": "goal", "id": "search_hiding_places",
    "doc": "Searching a house for someone held hostile who is believed to be in it and cannot be seen (decision D-950): to each place about where they were last believed to be that a person could hide in (whatever offers `core:search`, within six metres: wardrobes, lockers), the nearest first, each searched (opened and felt inside: whoever hides there is brought out) and stood at a while, looking and listening; then to where they were believed to be, a look round, and giving up until they are perceived again. Walking the rooms between, the searcher sees whoever is in the open as the light lets it, and hears whoever moves. Only while the belief is fresh: lost from sight, or told of, between three seconds and four minutes ago. How long it stands at each place is its own, two to four seconds.",
    "about": { "track": {
      "where": "self.hostile(it) and (self.last_seen(it) ?? 999) >= 3 and (self.last_seen(it) ?? 999) < 240 and len(places(self.believed_loc(it), 6, 'core:search')) > 0",
      "best": "self.confidence(it) ?? 0" } },
    "score": "self.weight('duty') * 3",
    "commit": 0.2,
    "interrupts": true,
    "retry_after": "60 s",
    "methods": [
      { "if": "len(places(self.believed_loc($about), 6, 'core:search', self.var.searched ?? [])) > 0",
        "steps": [
          { "set": { "var": "core:search_spot", "value": "first(places(self.believed_loc($about), 6, 'core:search', self.var.searched ?? []))" } },
          { "set": { "var": "core:searched", "value": "(self.var.searched ?? []) + [self.var.search_spot]" } },
          { "go": { "to": "self.var.search_spot", "within": 1 } },
          { "do": { "action": "core:interact", "with": { "target": "self.var.search_spot", "interaction": "'core:search'" } } },
          { "look": { "at": "self.var.search_spot", "time": "rand(2, 4)" } } ] },
      { "steps": [
          { "set": { "var": "core:searched", "value": "[]" } },
          { "go": { "to": "self.believed_loc($about)", "within": 1 } },
          { "look": { "time": "3 s" } },
          { "settle": true } ] }
    ] },

  { "type": "variable", "id": "searched", "scope": "entity", "value": "list<element>",
    "doc": "The places a searcher has searched since it began looking for someone (`core:search_hiding_places`): passed over until the search ends." },
  { "type": "variable", "id": "search_spot", "scope": "entity", "value": "element",
    "doc": "The place a searcher is searching now (`core:search_hiding_places`)." },

  { "type": "goal", "id": "search_lost",
    "doc": "Looking for someone held hostile who has been lost from sight: to where they were last believed to be, a look round, then giving up until they are perceived again.",
    "about": { "track": {
      "where": "self.hostile(it) and (self.last_seen(it) ?? 99) >= 3 and (self.last_seen(it) ?? 99) < 60",
      "best": "self.confidence(it) ?? 0" } },
    "score": "self.weight('duty') * 2 * (0.5 + (self.confidence($about) ?? 0))",
    "commit": 0.2,
    "interrupts": true,
    "retry_after": "30 s",
    "methods": [
      { "steps": [
          { "go": { "to": "self.believed_loc($about)", "within": 1 } },
          { "look": { "at": "$about", "time": "2 s" } },
          { "look": { "time": "2 s" } },
          { "settle": true } ] },
      { "steps": [
          { "look": { "time": "2 s" } },
          { "settle": true } ] }
    ] }
]
