[
  { "//": "Handling things (06 §9.2): picking up, dropping, wearing, taking off, stowing, putting in, taking out and giving, as actions. Each is the engine's holding verb of that name inside an action that takes time and a hand. `requires` asks `self.hold_fault`, which says as the character believes why it could not (its hands full, the thing out of reach, nothing to carry it in), and `fail_text` says it; the same is asked again, against the truth, when the action ends, in case the world moved meanwhile, and what is wrong then is said to the character. The inventory names these actions bare (`ui:item`), and so does the pick-up key (`ui:pick_up`). Values are illustrative.",
    "type": "action", "id": "pick_up", "name": "Pick up",
    "uses": { "arm": 1 },
    "params": { "what": "entity" },
    "requires": "is_null(self.hold_fault('take', $what))",
    "fail_text": "{self.hold_fault('take', $what) ?? 'That cannot be picked up.'}",
    "tags": ["holding"],
    "phases": [
      { "id": "reach", "time": "600 ms", "cancel": true },
      { "id": "lift", "time": 0,
        "do": [ { "if": "not is_null(self.hold_fault('take', $what))",
                  "then": [ { "message": { "text": "{self.hold_fault('take', $what)}", "to": "self" } } ],
                  "else": [ { "if": "is_null(self.hold_fault('grasp', $what))",
                              "then": [ { "take": { "who": "self", "what": "$what" } } ],
                              "else": [ { "stow": { "who": "self", "what": "$what" } } ] } ] } ] } ] },

  { "type": "action", "id": "drop", "name": "Drop",
    "params": { "what": "entity" },
    "requires": "is_null(self.hold_fault('drop', $what))",
    "fail_text": "{self.hold_fault('drop', $what) ?? 'That cannot be dropped.'}",
    "tags": ["holding"],
    "phases": [
      { "id": "let_go", "time": "300 ms", "cancel": true },
      { "id": "down", "time": 0,
        "do": [ { "if": "is_null(self.hold_fault('drop', $what))",
                  "then": [ { "drop": { "what": "$what" } } ],
                  "else": [ { "message": { "text": "{self.hold_fault('drop', $what)}", "to": "self" } } ] } ] } ] },

  { "type": "action", "id": "wear", "name": "Wear",
    "uses": { "arm": 2 },
    "params": { "what": "entity" },
    "requires": "is_null(self.hold_fault('wear', $what))",
    "fail_text": "{self.hold_fault('wear', $what) ?? 'That cannot be worn.'}",
    "tags": ["holding"],
    "phases": [
      { "id": "put_on", "time": "3 s", "cancel": true },
      { "id": "on", "time": 0,
        "do": [ { "if": "is_null(self.hold_fault('wear', $what))",
                  "then": [ { "wear": { "who": "self", "what": "$what" } } ],
                  "else": [ { "message": { "text": "{self.hold_fault('wear', $what)}", "to": "self" } } ] } ] } ] },

  { "//": "Takes a worn thing off into a hand: drop it after to put it down.",
    "type": "action", "id": "take_off", "name": "Take off",
    "uses": { "arm": 2 },
    "params": { "what": "entity" },
    "requires": "is_null(self.hold_fault('remove', $what))",
    "fail_text": "{self.hold_fault('remove', $what) ?? 'That cannot be taken off.'}",
    "tags": ["holding"],
    "phases": [
      { "id": "pull_off", "time": "2 s", "cancel": true },
      { "id": "off", "time": 0,
        "do": [ { "if": "is_null(self.hold_fault('remove', $what))",
                  "then": [ { "remove": { "what": "$what" } } ],
                  "else": [ { "message": { "text": "{self.hold_fault('remove', $what)}", "to": "self" } } ] } ] } ] },

  { "//": "Puts a thing away into the first container worn or held that takes it.",
    "type": "action", "id": "stow", "name": "Stow",
    "uses": { "arm": 1 },
    "params": { "what": "entity" },
    "requires": "is_null(self.hold_fault('stow', $what))",
    "fail_text": "{self.hold_fault('stow', $what) ?? 'That cannot be put away.'}",
    "tags": ["holding"],
    "phases": [
      { "id": "put_away", "time": "1 s", "cancel": true },
      { "id": "away", "time": 0,
        "do": [ { "if": "is_null(self.hold_fault('stow', $what))",
                  "then": [ { "stow": { "who": "self", "what": "$what" } } ],
                  "else": [ { "message": { "text": "{self.hold_fault('stow', $what)}", "to": "self" } } ] } ] } ] },

  { "//": "Puts a thing carried into a container carried or within reach.",
    "type": "action", "id": "put_in", "name": "Put in",
    "uses": { "arm": 1 },
    "params": { "what": "entity", "container": "entity" },
    "requires": "is_null(self.hold_fault('put_in', $what, $container))",
    "fail_text": "{self.hold_fault('put_in', $what, $container) ?? 'It does not go in there.'}",
    "tags": ["holding"],
    "phases": [
      { "id": "put", "time": "1 s", "cancel": true },
      { "id": "in", "time": 0,
        "do": [ { "if": "is_null(self.hold_fault('put_in', $what, $container))",
                  "then": [ { "put_in": { "what": "$what", "container": "$container" } } ],
                  "else": [ { "message": { "text": "{self.hold_fault('put_in', $what, $container)}", "to": "self" } } ] } ] } ] },

  { "//": "Takes a thing out of a container carried or within reach, into a hand.",
    "type": "action", "id": "take_out", "name": "Take out",
    "uses": { "arm": 1 },
    "params": { "what": "entity" },
    "requires": "is_null(self.hold_fault('take_out', $what))",
    "fail_text": "{self.hold_fault('take_out', $what) ?? 'It cannot be taken out.'}",
    "tags": ["holding"],
    "phases": [
      { "id": "reach_in", "time": "1 s", "cancel": true },
      { "id": "out", "time": 0,
        "do": [ { "if": "is_null(self.hold_fault('take_out', $what))",
                  "then": [ { "take_out": { "what": "$what", "to": "self" } } ],
                  "else": [ { "message": { "text": "{self.hold_fault('take_out', $what)}", "to": "self" } } ] } ] } ] },

  { "//": "Holds a thing out to someone within reach. Whoever opposes the giver or fears them will not take it (09 §3.4, 15 §9.1); anyone else takes it into a free hand.",
    "type": "action", "id": "give", "name": "Give",
    "uses": { "arm": 1 },
    "params": { "what": "entity", "to": "entity" },
    "requires": "is_null(self.hold_fault('give', $what, $to))",
    "fail_text": "{self.hold_fault('give', $what, $to) ?? 'You cannot give it to them.'}",
    "tags": ["holding"],
    "phases": [
      { "id": "hold_out", "time": "1 s", "cancel": true },
      { "id": "handed", "time": 0,
        "do": [ { "if": "not is_null(self.hold_fault('give', $what, $to))",
                  "then": [ { "message": { "text": "{self.hold_fault('give', $what, $to)}", "to": "self" } } ],
                  "else": [ { "if": "($to.stance_to(self) ?? 'neutral') == 'opposes' or ($to.fears(self) ?? false)",
                              "then": [ { "message": { "text": "{cap(the($to))} will not take it from you.", "to": "self" } } ],
                              "else": [ { "give": { "what": "$what", "to": "$to" } } ] } ] } ] } ] }
]
