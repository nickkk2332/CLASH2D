[
  { "//": "A country road between regions: three cells of paving.",
    "type": "path_kind", "id": "road", "tags": ["road"],
    "width": 3, "surface": { "floor": "asphalt" },
    "glyph": { "ch": "=", "fg": "gray" } },

  { "//": "A town street: three cells of asphalt with a pavement along each side.",
    "type": "path_kind", "id": "street", "tags": ["road", "street"],
    "width": 3, "surface": { "floor": "asphalt" },
    "edge": { "floor": "pavement", "width": 1 },
    "glyph": { "ch": "=", "fg": "gray" } },

  { "//": "A main road through a town: five cells of asphalt with a pavement along each side.",
    "type": "path_kind", "id": "main_street", "tags": ["road", "street", "main"],
    "width": 5, "surface": { "floor": "asphalt" },
    "edge": { "floor": "pavement", "width": 1 },
    "glyph": { "ch": "#", "fg": "gray" } },

  { "//": "The lowland ground with roads laid over it, for regions whose edges paths cross.",
    "type": "ground", "id": "open_ground",
    "params": { "trees": 0.0, "bushes": 0.01, "rocks": 0.004 },
    "depth": 12,
    "steps": [
      { "strata": [ { "depth": 2, "block": "solid@soil", "anchor": true },
                    { "block": "solid@granite", "anchor": true } ] },
      { "surface": { "floor": "grass", "ramp": "ramp@soil" } },
      { "caves": { "below": -4, "density": 0.01, "width": [1, 3] } },
      { "scatter": { "fixture": "tree", "density": "$trees", "apart": 1 } },
      { "scatter": { "fixture": "bush", "density": "$bushes" } },
      { "scatter": { "fixture": "boulder", "density": "$rocks", "apart": 2 } },
      { "paths": {} } ] },

  { "//": "The ground of a town: grass between the buildings, a bush here and there, and its streets.",
    "type": "ground", "id": "town_ground",
    "params": { "bushes": 0.004 },
    "depth": 8,
    "steps": [
      { "strata": [ { "depth": 2, "block": "solid@soil", "anchor": true },
                    { "block": "solid@granite", "anchor": true } ] },
      { "surface": { "floor": "grass", "ramp": "ramp@soil" } },
      { "scatter": { "fixture": "bush", "density": "$bushes", "apart": 2 } },
      { "paths": {} } ] },

  { "type": "tract", "id": "pasture", "tags": ["open", "rural"],
    "ground": "open_ground", "params": { "trees": 0.003 },
    "bands": ["overland"], "glyph": { "ch": "\"", "fg": "green" } },

  { "type": "tract", "id": "copse", "tags": ["wooded", "rural"],
    "ground": "open_ground", "params": { "trees": 0.12, "bushes": 0.04 },
    "bands": ["overland"], "glyph": { "ch": "Y", "fg": "green" } },

  { "//": "Land inside a town: what stands on it is its lots.",
    "type": "tract", "id": "town_lot", "tags": ["settled"],
    "ground": "town_ground",
    "bands": ["overland"], "glyph": { "ch": "#", "fg": "gray" } },

  { "//": "A farm by a road: a house with its yard, and the family who live there.",
    "type": "site", "id": "farmstead", "name": "Farmstead", "tags": ["farm", "home"],
    "map": "town_house",
    "roles": { "entrance": "mark:entrance" },
    "staff": [ { "creature": "person", "count": [1, 3], "in": "home", "role": "farmer" },
               { "creature": "house_dog", "chance": 0.5, "in": "home" } ] },

  { "//": "The square at the heart of a town.",
    "type": "site", "id": "town_square", "name": "Town square", "tags": ["civic", "public"],
    "map": "square",
    "roles": { "centre": "mark:centre", "entrance": "mark:entrance" },
    "staff": [ { "creature": "person", "count": [0, 2], "role": "idler" } ] },

  { "//": "Where the town is run from: any civic building with desks.",
    "type": "site", "id": "town_hall", "name": "Town hall", "tags": ["civic"],
    "map": { "tag": "civic" },
    "roles": { "desk": "mark:desk", "entrance": "mark:entrance" },
    "staff": [ { "creature": "person", "count": [1, 2], "at": "mark:desk", "role": "clerk" } ] },

  { "//": "Pasture and copses, with farms by the roads and roads across every edge.",
    "type": "region_kind", "id": "town_country", "tags": ["rural"],
    "tracts": [ { "tract": "pasture", "weight": 5 }, { "tract": "copse", "weight": 2 } ],
    "patch_size": 4,
    "sites": [ { "site": "farmstead", "per_region": [2, 4], "apart": 4, "near": "road" } ],
    "settlements": ["town", "village"],
    "paths": { "path": "road", "per_edge": [1, 2] },
    "glyph": { "ch": ".", "fg": "green" } },

  { "//": "A market town on a grid of streets, with main roads crossing at its centre: shops, offices and a square in the middle, houses and terraces round them, and houses with yards at the edge.",
    "type": "settlement", "id": "town", "tags": ["town"],
    "size": [8, 8],
    "tract": "town_lot",
    "streets": { "pattern": "grid", "spacing": [26, 30], "path": "street",
                 "main": 2, "main_path": "main_street" },
    "gap": 1,
    "zones": [
      { "zone": "centre", "to": 0.3, "lots": ["office", "shop"],
        "people": [ { "creature": "shopkeeper", "count": [0, 2], "role": "worker" } ] },
      { "zone": "town", "to": 0.7, "lots": ["terrace", "shop", "house"],
        "people": [ { "creature": "person", "count": [1, 3], "in": "home", "role": "resident" },
                    { "creature": "stall_keeper", "chance": 0.12, "in": "home", "role": "resident" },
                    { "creature": "rowdy", "chance": 0.06, "in": "home", "role": "resident" } ] },
      { "zone": "edge", "to": 1.0, "lots": ["yard", "house"],
        "people": [ { "creature": "person", "count": [1, 3], "in": "home", "role": "resident" },
                    { "creature": "house_dog", "chance": 0.3, "in": "home" } ] } ],
    "must_have": [ { "site": "town_square", "at": "centre" },
                   { "site": "town_hall", "at": "centre" } ],
    "home_mark": "bed" },

  { "//": "A village of crooked lanes: houses along streets that do not quite line up.",
    "type": "settlement", "id": "village", "tags": ["village"],
    "size": [4, 4],
    "tract": "town_lot",
    "streets": { "pattern": "organic", "spacing": [20, 28], "path": "road" },
    "gap": 2,
    "zones": [
      { "zone": "village", "to": 1.0, "lots": ["house"],
        "people": [ { "creature": "person", "count": [1, 2], "in": "home", "role": "resident" } ] } ],
    "home_mark": "bed" },

  { "//": "Flat country of two regions with a market town across the edge between them, a village in the east, farms by the roads and roads across every edge.",
    "type": "realm", "id": "town",
    "size_regions": [2, 1],
    "calendar": "common",
    "wrap": [],
    "z_range": [-32, 64],
    "generator": "standard",
    "generator_params": {
      "regions": [ { "kind": "town_country" } ],
      "settlements": [ { "settlement": "town", "at": [60, 28] },
                       { "settlement": "village", "at": [90, 40] } ]
    },
    "fill": { "below": "solid@granite", "above": null },
    "strata": [ { "from_z": -32, "gravity": 9.81, "atmosphere": "air", "sky": "day_night" } ],
    "time_rate": 1.0 }
]
