[
  { "//": "Stations (16 §4.2, §8): fixtures whose devices carry the tags recipes name in `at`. A station is a cell of the grid until someone works at it, stokes it or lights it, when it becomes a device that keeps its mode, its stores and the work under way. A workbench works whenever; a hearth and an oven only while lit, and burn wood from their own fuel store while they bake; a still distils by itself while it is fired, from what is put in it. Values are illustrative.",
    "type": "device", "id": "workbench", "name": "workbench",
    "tags": ["workbench"],
    "holds": { "volume": 0.2, "mass": "50 kg" } },

  { "type": "fixture", "id": "workbench", "material": "wood",
    "height": 0.9, "fill": 0.3,
    "device": "workbench",
    "interactions": ["store", "retrieve"],
    "glyph": { "ch": "π", "fg": "material" } },

  { "//": "Its modes are its fire: cold or lit. It bakes only lit, and a recipe that wants fuel takes it from its store, a kilogram of wood every two minutes.",
    "type": "device", "id": "oven", "name": "oven",
    "tags": ["oven", "hearth"],
    "modes": ["cold", "lit"],
    "stores": { "fuel": { "capacity": 20, "start": 0 } },
    "speed": { "value": 1.0, "when": ["lit"] },
    "holds": { "volume": 0.05, "mass": "20 kg" },
    "interactions": [] },

  { "type": "fixture", "id": "oven", "material": "brick",
    "height": 1.2, "fill": 0.8,
    "device": "oven",
    "interactions": ["stoke", "light_fire", "put_out_fire"],
    "glyph": { "ch": "Ω", "fg": "red" } },

  { "//": "A hearth: an oven's fire in the open. It cooks what an oven bakes, more slowly.",
    "type": "device", "id": "hearth", "name": "hearth",
    "tags": ["hearth"],
    "modes": ["cold", "lit"],
    "stores": { "fuel": { "capacity": 10, "start": 0 } },
    "speed": { "value": 0.5, "when": ["lit"] } },

  { "type": "fixture", "id": "hearth", "material": "brick",
    "height": 0.4, "fill": 0.5,
    "device": "hearth",
    "interactions": ["stoke", "light_fire", "put_out_fire"],
    "glyph": { "ch": "&", "fg": "red" } },

  { "//": "A still runs by itself while it is fired: put ale in it and it gives back the spirit of it. Its boiler burns fuel, at most a kilogram a minute, so a still that wants more works more slowly.",
    "type": "device", "id": "still", "name": "still",
    "tags": ["still"],
    "modes": ["cold", "lit"],
    "stores": { "fuel": { "capacity": 10, "start": 0, "rate": 0.01 } },
    "speed": { "value": 1.0, "when": ["lit"] },
    "auto": { "when": ["lit"] },
    "holds": { "volume": 0.05, "mass": "30 kg" } },

  { "type": "fixture", "id": "still", "material": "steel",
    "height": 1.5, "fill": 0.4,
    "device": "still",
    "interactions": ["stoke", "light_fire", "put_out_fire", "store", "retrieve"],
    "glyph": { "ch": "δ", "fg": "material" } },

  { "//": "A rack of shelves that holds things, so that a bench can draw on what lies on it.",
    "type": "device", "id": "rack", "name": "rack",
    "tags": ["storage"],
    "holds": { "volume": 0.3, "mass": "60 kg" } },

  { "type": "fixture", "id": "rack", "material": "wood",
    "height": 2.0, "fill": 0.15,
    "device": "rack",
    "interactions": ["store", "retrieve"],
    "glyph": { "ch": "[", "fg": "material" } },

  { "//": "A bed of herbs: growing is a recipe whose `while` is a condition on the place (16 §8.4). It grows only where there is water about.",
    "type": "device", "id": "herb_bed", "name": "herb bed",
    "tags": ["planter"],
    "auto": true,
    "holds": { "volume": 0.05, "mass": "10 kg" } },

  { "type": "fixture", "id": "herb_bed", "material": "soil",
    "height": 0.2, "fill": 0.6,
    "device": "herb_bed",
    "interactions": ["store", "retrieve"],
    "glyph": { "ch": "\"", "fg": "green" } },

  { "//": "Puts what one holds in hand into a stove's fuel store: a log is two kilograms of wood.",
    "type": "interaction", "id": "stoke", "name": "Stoke",
    "reach": "adjacent", "time": "2 s", "noise": 0.2,
    "if": "len(self.held('grasp')) > 0",
    "fail_text": "You have nothing in hand to burn.",
    "do": [ { "for_each": "self.held('grasp')", "as": "thing",
              "do": [ { "if": "$thing.has_tag('fuel')",
                        "then": [ { "add_resource": { "to": "target", "resource": "fuel", "amount": "$thing.mass ?? 0" } },
                                  { "destroy_item": { "item": "$thing" } } ] } ] } ] },

  { "type": "interaction", "id": "light_fire", "name": "Light",
    "reach": "adjacent", "time": "3 s", "noise": 0.1,
    "if": "target.mode == 'cold' and (target.store('fuel') ?? 0) > 0",
    "fail_text": "It needs fuel to light, and must be cold.",
    "do": [ { "set_mode": { "of": "target", "mode": "lit" } } ],
    "default": true },

  { "type": "interaction", "id": "put_out_fire", "name": "Put out",
    "reach": "adjacent", "time": "2 s", "noise": 0.1,
    "if": "target.mode == 'lit'",
    "fail_text": "It is not lit.",
    "do": [ { "set_mode": { "of": "target", "mode": "cold" } } ] }
]
