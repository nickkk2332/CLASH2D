[
  { "//": "How the reserves and attributes of living things are shown, put into the slots the `ui` mod's screens leave for content: the play screen's status column (`ui:play.bars`) and the condition screen (`ui:condition.pools`, `ui:condition.attributes`). Each is shown only while the character has what it shows. A mod of its own, which needs both `core` and `ui`, so that neither of those needs the other.",
    "type": "ui_part", "id": "blood_bar", "into": "ui:play.bars", "order": 10, "required": false,
    "if": "not is_null(view.pool.blood)",
    "widget": { "bar": { "label": "Blood ", "value": "view.pool.frac('blood')", "style": "blood" } } },
  { "type": "ui_part", "id": "pain_bar", "into": "ui:play.bars", "order": 20, "required": false,
    "if": "not is_null(view.pool.pain)",
    "widget": { "bar": { "label": "Pain  ", "value": "view.pool.frac('pain')", "style": "warn" } } },

  { "//": "What powers are paid from, while the character has them, so that a cost in the abilities screen can be read against what is left.",
    "type": "ui_part", "id": "stamina_bar", "into": "ui:play.bars", "order": 30, "required": false,
    "if": "not is_null(view.pool.stamina)",
    "widget": { "bar": { "label": "Stam  ", "value": "view.pool.frac('stamina')", "style": "info" } } },
  { "type": "ui_part", "id": "reserve_bar", "into": "ui:play.bars", "order": 40, "required": false,
    "if": "not is_null(view.pool.reserve)",
    "widget": { "bar": { "label": "Rsrv  ", "value": "view.pool.frac('reserve')", "style": "info" } } },
  { "//": "Poison and a draught show only while something is in the blood.",
    "type": "ui_part", "id": "toxin_bar", "into": "ui:play.bars", "order": 50, "required": false,
    "if": "(view.pool.frac('toxin') ?? 0) > 0",
    "widget": { "bar": { "label": "Toxin ", "value": "view.pool.frac('toxin')", "style": "warn" } } },
  { "type": "ui_part", "id": "sedation_bar", "into": "ui:play.bars", "order": 60, "required": false,
    "if": "(view.pool.frac('sedation') ?? 0) > 0",
    "widget": { "bar": { "label": "Drowsy", "value": "view.pool.frac('sedation')", "style": "warn" } } },

  { "//": "Hunger (`core`'s `substances/hunger.json`) shows while it bites: what was eaten, below a quarter, and the state it has brought the character to.",
    "type": "ui_part", "id": "hunger_bar", "into": "ui:play.bars", "order": 70, "required": false,
    "if": "(view.pool.frac('nourishment') ?? 1) < 0.25",
    "widget": { "bar": { "label": "Fed   ", "value": "view.pool.frac('nourishment')", "style": "warn" } } },
  { "type": "ui_part", "id": "hunger_state", "into": "ui:play.side", "order": 20, "required": false,
    "if": "view.has_tag('hungry')",
    "widget": { "text": { "value": "<warn>{if view.has_tag('starving') then 'Starving' else if view.has_tag('weak') then 'Weak with hunger' else 'Hungry'}</>", "wrap": false } } },

  { "//": "The hour where the character stands, by the sky: a game with a deadline (the errand's nightfall, the last stand's dawn) is played against it. Nothing is shown where there is no sky.",
    "type": "ui_part", "id": "clock", "into": "ui:play.side", "order": 10, "required": false,
    "if": "not is_null(view.loc.time_of_day ?? null)",
    "widget": { "text": { "value": "<dim>Time</> {floor((view.loc.time_of_day ?? 0) / 3600)}:{if 10 > floor(floor(view.loc.time_of_day ?? 0) % 3600 / 60) then '0' else ''}{floor(floor(view.loc.time_of_day ?? 0) % 3600 / 60)}", "wrap": false } } },

  { "type": "ui_part", "id": "blood_reserve", "into": "ui:condition.pools", "order": 10, "required": false,
    "if": "not is_null(view.pool.blood)",
    "widget": { "rows": [
      { "bar": { "label": "Blood ", "value": "view.pool.frac('blood')", "style": "blood" } },
      { "text": "<dim>Below 60% one falls; below 40% one dies.</>" } ] } },
  { "type": "ui_part", "id": "pain_reserve", "into": "ui:condition.pools", "order": 20, "required": false,
    "if": "not is_null(view.pool.pain)",
    "widget": { "rows": [
      { "bar": { "label": "Pain  ", "value": "view.pool.frac('pain')", "style": "warn" } },
      { "text": "<dim>Above 90% one falls.</>" } ] } },
  { "type": "ui_part", "id": "nourishment_reserve", "into": "ui:condition.pools", "order": 30, "required": false,
    "if": "not is_null(view.pool.nourishment)",
    "widget": { "rows": [
      { "bar": { "label": "Fed   ", "value": "view.pool.frac('nourishment')", "style": "good" } },
      { "text": "<dim>What was eaten and drunk; it falls by the hour. Below a quarter one is hungry, below a tenth weak; at nothing one starves, falls, and dies.</>" } ] } },
  { "type": "ui_part", "id": "toxin_reserve", "into": "ui:condition.pools", "order": 40, "required": false,
    "if": "not is_null(view.pool.toxin)",
    "widget": { "rows": [
      { "bar": { "label": "Toxin ", "value": "view.pool.frac('toxin')", "style": "warn" } },
      { "text": "<dim>Above 50% one falls; above 95% one dies.</>" } ] } },
  { "type": "ui_part", "id": "power_reserves", "into": "ui:condition.pools", "order": 50, "required": false,
    "if": "not is_null(view.pool.stamina) or not is_null(view.pool.reserve)",
    "widget": { "rows": [
      { "if": "not is_null(view.pool.stamina)",
        "bar": { "label": "Stam  ", "value": "view.pool.frac('stamina')", "style": "info" } },
      { "if": "not is_null(view.pool.reserve)",
        "bar": { "label": "Rsrv  ", "value": "view.pool.frac('reserve')", "style": "info" } },
      { "text": "<dim>What powers are paid from; both come back with rest.</>" } ] } },

  { "type": "ui_part", "id": "attributes", "into": "ui:condition.attributes", "order": 10, "required": false,
    "if": "not is_null(view.attr.strength)",
    "widget": { "text": "Strength {view.attr.strength:.0}  Wits {view.attr.wits:.0}  Speed {view.attr.speed:.1}" } }
]
