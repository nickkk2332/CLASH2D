    "log": "{the(self)} cannot strike: {event.message}", "importance": "minor" },
  { "type": "show", "id": "staggered", "on": "staggered",
    "log": "{the(self)} {verb(self, 'stagger')}.", "importance": "normal" },
  { "type": "show", "id": "ability_used", "on": "ability_used",
    "change": [],
    "log": "{the(self)} {verb(self, 'use')} a power.", "importance": "normal", "sound": "power" },
  { "type": "show", "id": "ability_refused", "on": "ability_refused",
