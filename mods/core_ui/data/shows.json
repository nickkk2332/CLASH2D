    "if": "not is_null(target)",
    "anim": "thud", "at": "target",
    "log": "{the(self)} {verb(self, 'strike')} {the(target)}.", "importance": "normal", "sound": "blow",
    "heard": { "log": "A blow lands somewhere close.", "marker": "!" } },
  { "type": "show", "id": "strike_landed_on_world", "on": "strike_landed",
    "if": "is_null(target)",
    "anim": "chip", "at": "here",
    "log": "{the(self)} {verb(self, 'strike')} something.", "importance": "minor", "sound": "blow" },
  { "type": "show", "id": "strike_missed", "on": "strike_missed",
    "change": [],
    "log": "{the(self)} {verb(self, 'miss')}{if is_null(target) then '' else ' ' + the(target)}.", "importance": "normal" },
  { "type": "show", "id": "strike_stopped", "on": "strike_stopped",
