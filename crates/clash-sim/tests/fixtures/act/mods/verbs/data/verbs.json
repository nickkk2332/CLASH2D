[
  { "type": "eoc", "id": "haste",
    "subjects": { "self": "entity" }, "params": { "rate": "real" },
    "do": [ { "set_time_rate": { "who": "self", "rate": "$rate" } } ] },
  { "type": "eoc", "id": "unhaste",
    "subjects": { "self": "entity" },
    "do": [ { "set_time_rate": { "who": "self" } } ] },
  { "type": "eoc", "id": "pin",
    "subjects": { "self": "entity" },
    "do": [ { "anchor_clock": { "who": "self", "to": "self.loc.realm" } } ] },
  { "type": "eoc", "id": "unpin",
    "subjects": { "self": "entity" },
    "do": [ { "anchor_clock": { "who": "self" } } ] },
  { "type": "eoc", "id": "slow_realm",
    "subjects": { "self": "entity" },
    "do": [ { "set_clock_rate": { "of": "self.loc.realm", "rate": 0.5 } } ] },
  { "type": "eoc", "id": "take_over",
    "subjects": { "self": "entity" },
    "do": [ { "set_control": { "who": "self", "mode": "direct" } } ] },
  { "type": "eoc", "id": "sideways",
    "subjects": { "self": "entity" },
    "do": [ { "set_control": { "who": "self", "mode": "sideways" } } ] },
  { "type": "eoc", "id": "mark",
    "subjects": { "self": "entity" },
    "do": [ { "add_tag": { "to": "self", "tag": "marked" } } ] },
  { "type": "eoc", "id": "unmark",
    "subjects": { "self": "entity" },
    "do": [ { "remove_tag": { "from": "self", "tag": "marked" } } ] },

  { "type": "variable", "id": "marks", "scope": "global", "value": "int", "default": 0,
    "doc": "How many tags have been given." },
  { "type": "eoc", "id": "count_marks",
    "on": "tag_changed", "filter": { "tag": "marked", "added": true },
    "doc": "A rule can listen for what a verb raises.",
    "do": [ { "add": { "global.var.marks": 1 } } ] }
]
