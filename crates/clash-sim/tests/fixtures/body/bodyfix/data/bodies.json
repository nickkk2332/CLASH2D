[
  { "type": "body_function", "id": "sight", "name": "Sight", "combine": "sum" },
  { "type": "body_function", "id": "grasp", "name": "Grasp", "combine": "sum" },
  { "type": "body_function", "id": "walking", "name": "Walking", "combine": "sum" },
  { "type": "body_function", "id": "breathing", "name": "Breathing", "combine": "mean" },
  { "//": "Any one heart will do.",
    "type": "body_function", "id": "circulation", "name": "Circulation", "combine": "max" },
  { "type": "body_function", "id": "thought", "name": "Thought", "combine": "max" },
  { "//": "Every foot is needed.",
    "type": "body_function", "id": "footing", "name": "Footing", "combine": "min" },

  { "type": "body_part", "id": "torso", "name": "torso",
    "mass": "35 kg", "length": "0.6 m", "girth": "0.35 m",
    "layers": [
      { "material": "skin",   "thickness": "2 mm",  "weight": 0.05 },
      { "material": "muscle", "thickness": "40 mm", "weight": 0.45 },
      { "material": "bone",   "thickness": "15 mm", "weight": 0.50 } ],
    "sockets": {
      "neck":     { "count": 1, "accepts": ["head"] },
      "shoulder": { "count": 2, "accepts": ["arm"] },
      "hip":      { "count": 2, "accepts": ["leg"] } },
    "band": [0.45, 0.82],
    "tags": ["trunk"] },

  { "//": "Brings its brain with it wherever it is used.",
    "type": "body_part", "id": "head", "name": "head",
    "mass": "5 kg", "length": "0.25 m", "girth": "0.18 m",
    "layers": [
      { "material": "skin",   "thickness": "2 mm", "weight": 0.05 },
      { "material": "muscle", "thickness": "5 mm", "weight": 0.15 },
      { "material": "bone",   "thickness": "7 mm", "weight": 0.80 } ],
    "channels": { "voice": 1 },
    "sockets": { "eye_socket": { "count": 2, "accepts": ["eye"] } },
    "inside": [ { "id": "brain", "part": "brain" } ],
    "band": [0.87, 1.0] },

  { "type": "body_part", "id": "eye", "name": "eye",
    "mass": "0.01 kg", "length": "25 mm", "girth": "25 mm",
    "layers": [ { "material": "organ", "thickness": "20 mm" } ],
    "provides": { "sight": 0.5 },
    "band": [0.93, 0.95],
    "tags": ["sense"],
    "leaves": "nothing" },

  { "type": "body_part", "id": "arm", "name": "arm",
    "mass": "4 kg", "length": "0.7 m", "girth": "0.09 m",
    "layers": [
      { "material": "skin",   "thickness": "2 mm",  "weight": 0.05 },
      { "material": "muscle", "thickness": "30 mm", "weight": 0.50 },
      { "material": "bone",   "thickness": "20 mm", "weight": 0.45 } ],
    "channels": { "arm": 1 },
    "sockets": { "wrist": { "count": 1, "accepts": ["hand"] } },
    "surfaces": [ { "id": "elbow", "kind": "impact", "area": 1.2e-3, "give": 0.01, "span": 0.04 } ],
    "band": [0.55, 0.85],
    "tags": ["limb"] },

  { "type": "body_part", "id": "hand", "name": "hand",
    "mass": "0.5 kg", "length": "0.18 m", "girth": "0.08 m",
    "layers": [
      { "material": "skin",   "thickness": "1.5 mm", "weight": 0.10 },
      { "material": "muscle", "thickness": "10 mm",  "weight": 0.50 },
      { "material": "bone",   "thickness": "8 mm",   "weight": 0.40 } ],
    "provides": { "grasp": 0.5 },
    "channels": { "grip": 1 },
    "surfaces": [ { "id": "fist", "kind": "impact", "area": 5.0e-3, "give": 0.02, "span": 0.08 } ],
    "band": [0.45, 0.55],
    "tags": ["limb"] },

  { "type": "body_part", "id": "leg", "name": "leg",
    "mass": "11 kg", "length": "0.9 m", "girth": "0.15 m",
    "layers": [
      { "material": "skin",   "thickness": "2 mm",  "weight": 0.05 },
      { "material": "muscle", "thickness": "50 mm", "weight": 0.50 },
      { "material": "bone",   "thickness": "25 mm", "weight": 0.45 } ],
    "provides": { "walking": 0.5 },
    "channels": { "leg": 1 },
    "sockets": { "ankle": { "count": 1, "accepts": ["foot"] } },
    "band": [0.05, 0.5],
    "tags": ["limb"] },

  { "type": "body_part", "id": "foot", "name": "foot",
    "mass": "1 kg", "length": "0.25 m", "girth": "0.09 m",
    "layers": [
      { "material": "skin",   "thickness": "3 mm",  "weight": 0.10 },
      { "material": "muscle", "thickness": "15 mm", "weight": 0.40 },
      { "material": "bone",   "thickness": "10 mm", "weight": 0.50 } ],
    "provides": { "footing": 1.0 },
    "surfaces": [ { "id": "heel", "kind": "impact", "area": 4.0e-3, "give": 0.01, "span": 0.07 } ],
    "band": [0.0, 0.05] },

  { "type": "body_part", "id": "heart", "name": "heart",
    "mass": "0.3 kg", "length": "0.12 m", "girth": "0.08 m",
    "layers": [ { "material": "organ", "thickness": "30 mm" } ],
    "provides": { "circulation": 1.0 },
    "tags": ["vital"] },

  { "type": "body_part", "id": "lung", "name": "lung",
    "mass": "0.6 kg", "length": "0.25 m", "girth": "0.12 m",
    "layers": [ { "material": "organ", "thickness": "40 mm" } ],
    "provides": { "breathing": 1.0 },
    "tags": ["vital"] },

  { "type": "body_part", "id": "brain", "name": "brain",
    "mass": "1.4 kg", "length": "0.16 m", "girth": "0.14 m",
    "layers": [ { "material": "organ", "thickness": "60 mm" } ],
    "provides": { "thought": 1.0 },
    "tags": ["vital"] },

  { "type": "body_plan", "id": "humanoid", "name": "humanoid",
    "height": "1.75 m",
    "parts": [
      { "id": "torso",  "part": "torso" },
      { "id": "head",   "part": "head",  "on": "torso",  "socket": "neck" },
      { "id": "l_eye",  "part": "eye",   "on": "head",   "socket": "eye_socket", "side": "left" },
      { "id": "r_eye",  "part": "eye",   "on": "head",   "socket": "eye_socket", "side": "right" },
      { "id": "l_arm",  "part": "arm",   "on": "torso",  "socket": "shoulder",   "side": "left" },
      { "id": "r_arm",  "part": "arm",   "on": "torso",  "socket": "shoulder",   "side": "right" },
      { "id": "l_hand", "part": "hand",  "on": "l_arm",  "socket": "wrist",      "side": "left" },
      { "id": "r_hand", "part": "hand",  "on": "r_arm",  "socket": "wrist",      "side": "right" },
      { "id": "l_leg",  "part": "leg",   "on": "torso",  "socket": "hip",        "side": "left" },
      { "id": "r_leg",  "part": "leg",   "on": "torso",  "socket": "hip",        "side": "right" },
      { "id": "l_foot", "part": "foot",  "on": "l_leg",  "socket": "ankle",      "side": "left" },
      { "id": "r_foot", "part": "foot",  "on": "r_leg",  "socket": "ankle",      "side": "right" },
      { "id": "heart",  "part": "heart", "in": "torso" },
      { "id": "l_lung", "part": "lung",  "in": "torso",  "side": "left" },
      { "id": "r_lung", "part": "lung",  "in": "torso",  "side": "right" }
    ] },

  { "//": "One part, one layer: nothing in the engine expects limbs.",
    "type": "body_part", "id": "blob_mass", "name": "mass",
    "mass": "20 kg", "length": "0.8 m", "girth": "0.8 m",
    "layers": [ { "material": "jelly", "thickness": "400 mm" } ],
    "provides": { "walking": 1.0, "grasp": 0.2, "sight": 0.1 },
    "channels": { "pseudopod": 2 },
    "surfaces": [ { "id": "slam", "kind": "impact", "area": 0.05, "give": 0.1, "span": 0.3 } ],
    "band": [0.0, 1.0],
    "disable_below": 0.2 },

  { "type": "body_plan", "id": "blob", "name": "blob",
    "height": "0.8 m",
    "parts": [ { "id": "mass", "part": "blob_mass" } ] }
]
