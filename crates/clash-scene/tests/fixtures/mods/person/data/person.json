[
  { "//": "A small world to stand in, for the screens over the map.",
    "type": "material", "id": "stone", "density": 2000, "toughness": 1.0e6, "color": "#808080" },
  { "type": "material", "id": "oak", "density": 600, "toughness": 3.0e5, "color": "#c8a060" },
  { "type": "floor", "id": "boards", "material": "oak", "thickness": 0.1,
    "glyph": { "ch": ".", "fg": "material" } },
  { "type": "block", "id": "wall", "material": "stone", "height": 3.0, "fill": 0.2,
    "flags": ["opaque"], "glyph": { "ch": "#", "fg": "material" } },
  { "type": "block", "id": "door", "material": "oak", "height": 2.0, "fill": 0.1,
    "flags": ["opaque"],
    "states": { "shut": {}, "open": { "add_flags": ["passable"], "remove_flags": ["opaque"], "glyph": { "ch": "'" } } },
    "glyph": { "ch": "+", "fg": "material" } },

  { "type": "damage_type", "id": "cut", "default_resist": { "threshold": "1 MPa" } },

  { "//": "What the body is made of.",
    "type": "material", "id": "flesh", "density": 1060, "toughness": "1 MJ/m3",
    "leak": { "pool": "blood", "rate": 1.0, "closes": "5 min" },
    "signal": { "pool": "pain", "per_joule": 0.2 } },
  { "type": "material", "id": "bone", "density": 1900, "toughness": "100 MJ/m3" },

  { "type": "pool", "id": "blood", "name": "Blood", "max": 5, "start": "max",
    "thresholds": [0.0, 0.4, 0.6] },
  { "type": "pool", "id": "pain", "name": "Pain", "max": 100, "thresholds": [0.9] },
  { "type": "attribute", "id": "strength", "name": "Strength", "base": 10, "min": 0 },
  { "type": "attribute", "id": "wits", "name": "Wits", "base": 10, "min": 0 },

  { "type": "channel", "id": "grip", "name": "grip" },
  { "type": "channel", "id": "leg", "name": "leg" },
  { "type": "body_function", "id": "manipulation", "name": "Manipulation" },
  { "type": "body_function", "id": "locomotion", "name": "Locomotion" },

  { "type": "body_part", "id": "torso", "name": "torso",
    "mass": "30 kg", "length": "0.6 m", "girth": "0.35 m",
    "layers": [ { "material": "flesh", "thickness": "40 mm" }, { "material": "bone", "thickness": "15 mm" } ],
    "sockets": { "neck": { "accepts": ["head"] }, "shoulder": { "count": 2, "accepts": ["arm"] },
                 "hip": { "count": 2, "accepts": ["leg"] }, "tail": { "accepts": ["tail"] } } },
  { "type": "body_part", "id": "head", "name": "head",
    "mass": "5 kg", "length": "0.25 m", "girth": "0.18 m",
    "layers": [ { "material": "flesh", "thickness": "5 mm" }, { "material": "bone", "thickness": "7 mm" } ],
    "sockets": { "brow": { "count": 2, "accepts": ["horn"] } } },
  { "type": "body_part", "id": "arm", "name": "arm",
    "mass": "4 kg", "length": "0.7 m", "girth": "0.09 m",
    "layers": [ { "material": "flesh", "thickness": "30 mm" }, { "material": "bone", "thickness": "20 mm" } ],
    "sockets": { "wrist": { "accepts": ["hand"] } } },
  { "type": "body_part", "id": "hand", "name": "hand",
    "mass": "0.5 kg", "length": "0.18 m", "girth": "0.08 m",
    "layers": [ { "material": "flesh", "thickness": "10 mm" }, { "material": "bone", "thickness": "8 mm" } ],
    "provides": { "manipulation": 0.5 }, "channels": { "grip": 1 } },
  { "type": "body_part", "id": "leg", "name": "leg",
    "mass": "11 kg", "length": "0.9 m", "girth": "0.15 m",
    "layers": [ { "material": "flesh", "thickness": "50 mm" }, { "material": "bone", "thickness": "25 mm" } ],
    "provides": { "locomotion": 0.5 }, "channels": { "leg": 1 } },
  { "type": "body_part", "id": "heart", "name": "heart",
    "mass": "0.3 kg", "length": "0.12 m", "girth": "0.09 m",
    "layers": [ { "material": "flesh", "thickness": "40 mm" } ] },
  { "type": "body_part", "id": "tail", "name": "tail",
    "mass": "2 kg", "length": "0.8 m", "girth": "0.06 m",
    "layers": [ { "material": "flesh", "thickness": "20 mm" }, { "material": "bone", "thickness": "10 mm" } ] },
  { "type": "body_part", "id": "horn", "name": "horn",
    "mass": "0.2 kg", "length": "0.15 m", "girth": "0.04 m",
    "layers": [ { "material": "bone", "thickness": "20 mm" } ] },

  { "type": "body_plan", "id": "person", "name": "person", "height": "1.7 m",
    "parts": [
      { "id": "torso",  "part": "torso" },
      { "id": "head",   "part": "head",  "on": "torso", "socket": "neck" },
      { "id": "l_arm",  "part": "arm",   "on": "torso", "socket": "shoulder", "side": "left" },
      { "id": "l_hand", "part": "hand",  "on": "l_arm", "socket": "wrist",    "side": "left" },
      { "id": "r_arm",  "part": "arm",   "on": "torso", "socket": "shoulder", "side": "right" },
      { "id": "r_hand", "part": "hand",  "on": "r_arm", "socket": "wrist",    "side": "right" },
      { "id": "l_leg",  "part": "leg",   "on": "torso", "socket": "hip",      "side": "left" },
      { "id": "r_leg",  "part": "leg",   "on": "torso", "socket": "hip",      "side": "right" },
      { "id": "heart",  "part": "heart", "in": "torso" } ] },

  { "//": "A template with a choice of every kind 06 §10.2 defines: a text, a range, a pick, points (one option of which opens a choice of its own) and parts to assemble.",
    "type": "template", "id": "person", "kind": "species", "name": "Person",
    "body": "person", "pools": ["blood", "pain"], "mind": true,
    "attributes": { "strength": 10, "wits": 10 },
    "choices": [
      { "id": "name", "name": "Name", "kind": "text", "sets": "name", "max_length": 20 },
      { "id": "stature", "name": "Stature", "kind": "range", "sets": "scale",
        "min": 0.8, "max": 1.2, "default": 1.0 },
      { "id": "build", "name": "Build", "kind": "pick", "default": ["average"],
        "options": [
          { "id": "slight", "name": "Slight", "attributes": { "strength": 8 } },
          { "id": "average", "name": "Average" },
          { "id": "heavy", "name": "Heavy", "attributes": { "strength": 12 } } ] },
      { "id": "training", "name": "Training", "kind": "points", "budget": 3,
        "options": [
          { "id": "runner", "name": "Runner", "cost": 2 },
          { "id": "reader", "name": "Reader", "cost": 1, "attributes": { "wits": 12 },
            "choices": [
              { "id": "script", "name": "Script", "kind": "pick",
                "options": [ { "id": "plain", "name": "Plain hand" }, { "id": "court", "name": "Court hand" } ] } ] } ] },
      { "id": "extras", "name": "Extras", "kind": "assemble", "parts": ["tail", "horn"], "budget": 3 } ] },

  { "//": "Another kind to make, so that there is a choice of what to begin from.",
    "type": "template", "id": "shade", "kind": "spirit", "name": "Shade", "mind": true },

  { "//": "The reserves and attributes in the screens' slots, as content puts them there.",
    "type": "ui_part", "id": "blood_bar", "into": "ui:play.bars", "order": 10,
    "if": "not is_null(view.pool.blood)",
    "widget": { "bar": { "label": "Blood ", "value": "view.pool.frac('blood')", "style": "blood" } } },
  { "type": "ui_part", "id": "blood_reserve", "into": "ui:condition.pools", "order": 10,
    "if": "not is_null(view.pool.blood)",
    "widget": { "bar": { "label": "Blood ", "value": "view.pool.frac('blood')", "style": "blood" } } },
  { "type": "ui_part", "id": "pain_reserve", "into": "ui:condition.pools", "order": 20,
    "if": "not is_null(view.pool.pain)",
    "widget": { "bar": { "label": "Pain  ", "value": "view.pool.frac('pain')", "style": "warn" } } },
  { "type": "ui_part", "id": "attributes", "into": "ui:condition.attributes",
    "widget": { "text": "Strength {view.attr.strength:.0}  Wits {view.attr.wits:.0}" } }
]
