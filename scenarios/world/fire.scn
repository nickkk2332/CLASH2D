# Fire on a row of wooden boards: it spreads along them, burns them
# away and dies down where nothing is left to burn (02 §16).
use default seed=9
gen core:testland size=1
set @c:10,10,0 floor core:boards
set @c:11,10,0 floor core:boards
set @c:12,10,0 floor core:boards
set @c:13,10,0 floor core:boards
set @c:14,10,0 floor core:boards
set @c:15,10,0 floor core:boards
set @c:16,10,0 floor core:boards
field @c:10,10,0 core:fire 200
advance 2s
assert "@c:10,10,0.floor.def_id == 'core:boards'"
advance 10s
expect event element_destroyed layer=floor
assert "@c:10,10,0.floor == null"
advance 60s
assert "@c:16,10,0.floor == null"
expect hash fe3664cbdc5af1a9e5691d0c2fce7efd
