# mixed_belt (plans/combat.md, C10, review row "Ammunition as items"): a
# rifle's magazine is loaded with three ball rounds, two tracers and one
# more ball, and fires them in the order loaded, each with its own
# projectile and energy (07 §11.5): `count` six fires six. The magazine
# is then empty, and a shot from it is refused (`ranged.empty`, reported
# as a fault of the effect that asked for it). (The
# rifle takes the slot the spot left: it is listed before its holder.)
use default seed=7
gen core:testland size=1
spawn item at @c:10,10,0 as=spot
as @spot do { "spawn": { "template": "core:person", "at": "self.loc" } }
as @spot do { "spawn": { "template": "core:person", "at": "offset(self.loc, 20, 0, 0)" } }
remove @spot
as @e:1 do { "create_item": { "def": "core:rifle", "at": "self.loc" } }
as @e:1 do { "take": { "who": "self", "what": "self.loc.occupants[0]" } }
assert "@e:1.wielding('firearm') != null"
as @e:1 do { "create_item": { "def": "core:rifle_magazine", "at": "self.loc" } }
as @e:1 do { "fit": { "what": "self.loc.occupants[1]", "into": "self.wielding('firearm') ?? self" } }
as @e:1 do { "create_item": { "def": "core:rifle_round", "count": 3, "at": "self.loc" } }
as @e:1 do { "load": { "into": "self.wielding('firearm') ?? self", "from": "self.loc.occupants[1]" } }
as @e:1 do { "create_item": { "def": "core:rifle_round_tracer", "count": 2, "at": "self.loc" } }
as @e:1 do { "load": { "into": "self.wielding('firearm') ?? self", "from": "self.loc.occupants[1]" } }
as @e:1 do { "create_item": { "def": "core:rifle_round", "count": 1, "at": "self.loc" } }
as @e:1 do { "load": { "into": "self.wielding('firearm') ?? self", "from": "self.loc.occupants[1]" } }
assert "(@e:1.wielding('firearm').rounds ?? 0) == 6"
as @e:1 do { "shoot": { "at": "offset(self.loc, 20, 0, 0).occupants[0]", "store": "self.wielding('firearm')", "with": "self.wielding('firearm')", "count": 6, "spread": 0 } }
advance 1s
expect event projectile_fired
expect event projectile_hit
assert "(@e:1.wielding('firearm').rounds ?? 0) == 0"
assert "len(@e:2.wounds) > 0"
as @e:1 do { "shoot": { "at": "offset(self.loc, 20, 0, 0).occupants[0]", "store": "self.wielding('firearm')" } }
expect event fault
expect hash 94219d8d873a006bd91c8ece72d15671
