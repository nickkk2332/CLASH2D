# own_fist (plans/combat.md, C2): a strong, fragile striker is harmed by
# its own blow against a wall (07 §6.3). A person of strength 125 smashes
# a concrete wall with 1 kJ of fist: its 10 MPa do not reach the
# concrete's 20 MPa, the wall is not touched, and all of the blow comes
# back into the hand, breaching its skin and muscle and cracking its bone.
use default seed=3
gen core:testland size=1
set @c:11,10,0 block core:wall
spawn item at @c:10,10,0 as=spot
as @spot do { "spawn": { "template": "core:person", "at": "self.loc" } }
remove @spot
assert "@e:1.has_tag('person') and len(@e:1.wounds) == 0"
control @e:1 delegated
as @e:1 do { "set_attr_base": { "who": "self", "attr": "core:strength", "base": 125 } }
as @e:1 do { "start_action": { "who": "self", "action": "core:smash", "with": "{ 'at': offset(self.loc, 1, 0, 0) }" } }
advance 1s
expect event strike_landed
expect event strike_recoiled
assert "@c:11,10,0.block.def_id == 'core:wall'"
assert "len(@e:1.wounds) > 0"
expect hash 6a021493ace1855000e32db08239799c
